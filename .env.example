# Maximum accepted multipart upload size in MB (source PDFs). Default: 600.
# Raise to accept larger source PDFs (uploads stream to a temp file on disk).
MAX_PDF_UPLOAD_MB=600

# uvicorn listen port (Render provides this automatically in production)
PORT=10000

# Supabase (page/job queue + built-PDF storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-key
